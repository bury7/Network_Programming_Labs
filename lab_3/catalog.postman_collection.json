{
  "info": {
    "name": "Product catalog",
    "description": "Requests for the Lab 3 catalog REST API. Run the folder in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "itemId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        }
      }
    },
    {
      "name": "Create item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
              "const item = pm.response.json();",
              "pm.test(\"Item is created\", () => pm.expect(item).to.include({name: \"T-shirt\", price: 499.99, color: \"black\"}));",
              "pm.test(\"Location header points to the item\", () => pm.response.to.have.header(\"Location\", `/items/${item.id}`));",
              "pm.collectionVariables.set(\"itemId\", item.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"T-shirt\",\n    \"price\": 499.99,\n    \"color\": \"black\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Item ID matches\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"itemId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items/{{itemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items",
            "{{itemId}}"
          ]
        }
      }
    },
    {
      "name": "Update item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Item is updated\", () => pm.expect(pm.response.json()).to.include({price: 399.99, color: \"white\"}));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items/{{itemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items",
            "{{itemId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"T-shirt\",\n    \"price\": 399.99,\n    \"color\": \"white\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create invalid item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error is returned\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Cap\",\n    \"price\": -1,\n    \"color\": \"red\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items/{{itemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items",
            "{{itemId}}"
          ]
        }
      }
    },
    {
      "name": "Get deleted item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items/{{itemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items",
            "{{itemId}}"
          ]
        }
      }
    },
    {
      "name": "Replace catalog",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Catalog has 2 items\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n    {\n        \"name\": \"Jeans\",\n        \"price\": 1200,\n        \"color\": \"blue\"\n    },\n    {\n        \"name\": \"Socks\",\n        \"price\": 50,\n        \"color\": \"white\"\n    }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete all items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        }
      }
    },
    {
      "name": "List items without credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Basic auth is requested\", () => pm.response.to.have.header(\"WWW-Authenticate\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
